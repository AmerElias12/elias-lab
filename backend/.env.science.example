# The science service (app/science.py). Copy to .env.science and fill in.
#
# Nothing here is a database URL, because there is no database.

ELN_MODE=science
ELN_ENVIRONMENT=production

# --- who may call -----------------------------------------------------------
# Supabase → Project Settings → API. Use the JWT Secret, NOT the publishable
# (anon) key: the anon key is public, it is in this repository, and it is in
# the HTML of the live site. app/auth_light.py explains at length why the
# signature on it proves nothing.
ELN_SUPABASE_JWT_SECRET=

# For a project that signs with a published asymmetric key instead of the
# shared secret, set this and leave the secret blank; the JWKS endpoint is
# derived from it. Both may be set at once during a rotation between the two.
ELN_SUPABASE_URL=https://your-project-ref.supabase.co

# Only if this service should also accept tokens issued by the full ELN
# (backend/app/main.py). Leave blank otherwise — it cannot issue any.
# ELN_JWT_SECRET=

# --- who may call it from a browser ----------------------------------------
# The origin the pages are served from. Required in production: with this
# empty, every response is discarded by the same-origin policy and the service
# looks like it is down.
ELN_CORS_ORIGINS=["https://amerelias12.github.io"]
