# Copy to .env. .env is gitignored; this file is not, so keep real values out.

# The role must be eln_app — not the owner, not a superuser — or every policy
# in docs/eln-rls.sql is inert. The app refuses to start in production if it
# detects otherwise, and warns in development.
ELN_DATABASE_URL=postgresql+asyncpg://eln_app:password@localhost:5432/eln

# No default. Generate with:  openssl rand -hex 32
ELN_JWT_SECRET=

# Migrations connect as a role that can CREATE ROLE, set BYPASSRLS and change
# function ownership — none of which eln_app may do, and none of which it
# should gain. Leave unset only when one role does everything, which is true
# of a local database and of nowhere else.
# ELN_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/eln

# development | production
ELN_ENVIRONMENT=development

# How long an access token is good for. Short, because it cannot be withdrawn
# once issued; the refresh cookie renews it quietly.
ELN_ACCESS_TOKEN_MINUTES=15

# How long somebody stays signed in without using the app. Rotation means a
# session in daily use renews indefinitely; this is the idle limit.
ELN_REFRESH_TOKEN_DAYS=30

# The refresh cookie is Secure in production and not in development, where
# localhost is http and a Secure cookie would never be sent. Set it only to
# override that.
# ELN_COOKIE_SECURE=true

# Only needed if a frontend is served from a different origin. The bundled
# dashboard is served by this app, so leave it empty.
# ELN_CORS_ORIGINS=["https://notebook.example.edu"]
