# Copy to .env (same folder) and fill in. .env is git-ignored: this repository
# is public, and these keys can spend money and post to the lab's account.
# Check them with:  python pipeline.py check

# ── Claude: writes each day's video prompt, subtitles, caption and hashtags ──
# https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Video generator: set the one named in pipeline.toml [video] provider ─────
# PiAPI (provider = "piapi"): sign in at https://piapi.ai and copy your API key
PIAPI_API_KEY=
# Kling directly (provider = "kling"): https://app.klingai.com/global/dev → API keys
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Only if Kling gave you a regional endpoint, e.g. https://api-singapore.klingai.com
# KLING_BASE_URL=

# ── Instagram (Graph API, Content Publishing) ──────────────────────────────
# The account's numeric user ID (not the @handle).
IG_USER_ID=
# A long-lived access token with permission to publish. Lasts 60 days.
IG_ACCESS_TOKEN=
# graph.instagram.com for a token from "Instagram API with Instagram Login"
# (the default). graph.facebook.com for one from the Facebook Login flow.
# IG_GRAPH_HOST=graph.instagram.com
# IG_API_VERSION=v23.0

# ── Scheduler (scheduler/index.js, node-cron) ──────────────────────────────
# When to post: minute hour day-of-month month day-of-week. Default 17:45 daily.
CRON_SCHEDULE=45 17 * * *
# The time zone CRON_SCHEDULE is read in (default: this computer's).
CRON_TIMEZONE=Asia/Jerusalem
# Hours to wait before retrying a failed run (0 = wait for tomorrow).
# CRON_RETRY_HOURS=2
# The Python to run the pipeline with (default: .venv, then python3).
# PYTHON=

# ── Rendering ──────────────────────────────────────────────────────────────
# A bold .ttf/.otf for subtitles, if the bot cannot find one on its own.
# REELBOT_FONT=/path/to/Font-Bold.ttf
