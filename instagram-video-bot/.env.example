# Copy to .env (same folder) and fill in. .env is git-ignored: this repository
# is public, and a token in it can post to the lab's account.

# The Instagram account's numeric user ID (not the @handle).
IG_USER_ID=

# A long-lived access token with permission to publish content. It lasts
# 60 days; `python bot.py check` tells you when it has expired.
IG_ACCESS_TOKEN=

# graph.instagram.com for a token from "Instagram API with Instagram Login"
# (the default). graph.facebook.com for one from the Facebook Login flow.
# IG_GRAPH_HOST=graph.instagram.com

# Graph API version. Meta retires each version about two years after release.
# IG_API_VERSION=v23.0

# A bold .ttf/.otf for slide text, if the bot cannot find one on its own.
# REELBOT_FONT=/path/to/Font-Bold.ttf
